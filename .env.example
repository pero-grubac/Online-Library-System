# Copy to .env next to docker-compose.yml and fill in. .env is ignored by Git.

# Staff account of the LibraryServer. The Library app logs in with the same values:
# set LIBRARY_ADMIN_USERNAME / LIBRARY_ADMIN_PASSWORD in its environment (or ADMIN_* in its app.properties).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs session tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional: lets LibraryServer e-mail books to members. For Gmail use an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=library@example.com
MAIL_PASSWORD=
